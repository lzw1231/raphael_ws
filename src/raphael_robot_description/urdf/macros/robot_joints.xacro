<?xml version="1.0"?>
<!-- 关节定义 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="link00"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="link00_link01_joint" type="fixed">
        <parent link="link00"/>
        <child link="link01"/>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </joint>

    <joint name="link01_link02_joint" type="fixed">
        <parent link="link01"/>
        <child link="link02"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link02_link03_joint" type="fixed">
        <parent link="link02"/>
        <child link="link03"/>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </joint>

    <joint name="link03_link04_joint" type="fixed">
        <parent link="link03"/>
        <child link="link04"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link04_link05_joint" type="fixed">
        <parent link="link04"/>
        <child link="link05"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

    <joint name="link05_link06_joint" type="fixed">
        <parent link="link05"/>
        <child link="link06"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link06_link07_joint" type="fixed">
        <parent link="link06"/>
        <child link="link07"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link07_link08_joint" type="fixed">
        <parent link="link07"/>
        <child link="link08"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link08_link09_joint" type="fixed">
        <parent link="link08"/>
        <child link="link09"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

    <joint name="link09_link09b_joint" type="fixed">
        <parent link="link09"/>
        <child link="link09b"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link09b_link10_joint" type="fixed">
        <parent link="link09b"/>
        <child link="link10"/>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>

    <joint name="link10_link11_joint" type="fixed">
        <parent link="link10"/>
        <child link="link11"/>
        <origin xyz="0 -0.0050 0.01" rpy="0 0 0"/>
    </joint>

    <joint name="link10_link12_joint" type="fixed">
        <parent link="link10"/>
        <child link="link12"/>
        <origin xyz="0 0.005 0.01" rpy="0 0 0"/>
    </joint>

</robot>