<?xml version="1.0" encoding="UTF-8"?>
<!-- 关节定义 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- jonints -->
    <xacro:macro name="get_snake_joints" params="prefix">
        <joint name="${prefix}_link00_link01_joint" type="fixed">
            <parent link="${prefix}_link00"/>
            <child link="${prefix}_link01"/>
            <origin xyz="0.050 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link01_link02_joint" type="fixed">
            <parent link="${prefix}_link01"/>
            <child link="${prefix}_link02"/>
            <origin xyz="0.0033 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link02_link03_joint" type="fixed">
            <parent link="${prefix}_link02"/>
            <child link="${prefix}_link03"/>
            <origin xyz="0.0033 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link03_link04_joint" type="fixed">
            <parent link="${prefix}_link03"/>
            <child link="${prefix}_link04"/>
            <origin xyz="0.0238 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link04_link05_joint" type="fixed">
            <parent link="${prefix}_link04"/>
            <child link="${prefix}_link05"/>
            <origin xyz="0.0033 0 0" rpy="0 0 0"/>
        </joint>


        <joint name="${prefix}_link05_link06_joint" type="fixed">
            <parent link="${prefix}_link05"/>
            <child link="${prefix}_link06"/>
            <origin xyz="0.0123 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link06_link07_joint" type="fixed">
            <parent link="${prefix}_link06"/>
            <child link="${prefix}_link07"/>
            <origin xyz="0.0033 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link07_link08_joint" type="fixed">
            <parent link="${prefix}_link07"/>
            <child link="${prefix}_link08"/>
            <origin xyz="0.0033 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link08_link09_joint" type="fixed">
            <parent link="${prefix}_link08"/>
            <child link="${prefix}_link09"/>
            <origin xyz="0.0033 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link09_link09b_joint" type="fixed">
            <parent link="${prefix}_link09"/>
            <child link="${prefix}_link09b"/>
            <origin xyz="0.0123 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link09b_link10_joint" type="fixed">
            <parent link="${prefix}_link09b"/>
            <child link="${prefix}_link10"/>
            <origin xyz="0.0058 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link10_link11_joint" type="fixed">
            <parent link="${prefix}_link10"/>
            <child link="${prefix}_link11"/>
            <origin xyz="0.01 0 0" rpy="0 0 0"/>
        </joint>

        <joint name="${prefix}_link10_link12_joint" type="fixed">
            <parent link="${prefix}_link10"/>
            <child link="${prefix}_link12"/>
            <origin xyz="0.01 0 0" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

</robot>