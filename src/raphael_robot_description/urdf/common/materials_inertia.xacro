<?xml version="1.0"?>
<!-- 全局材质库 + 标准几何体惯性计算宏集合 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Link0 ~ Link13 渐变材质，RViz / Gazebo 通用 -->

    <xacro:property name="alpha_val" value="1"/>

    <material name="color_0">
        <color rgba="0.08 0.18 0.46 ${alpha_val}"/>
    </material>
    <material name="color_1">
        <color rgba="0.06 0.30 0.62 ${alpha_val}"/>
    </material>
    <material name="color_2">
        <color rgba="0.04 0.42 0.70 ${alpha_val}"/>
    </material>
    <material name="color_3">
        <color rgba="0.02 0.52 0.72 ${alpha_val}"/>
    </material>
    <material name="color_4">
        <color rgba="0.00 0.60 0.70 ${alpha_val}"/>
    </material>
    <material name="color_5">
        <color rgba="0.00 0.66 0.62 ${alpha_val}"/>
    </material>
    <material name="color_6">
        <color rgba="0.00 0.68 0.48 ${alpha_val}"/>
    </material>
    <material name="color_7">
        <color rgba="0.04 0.66 0.32 ${alpha_val}"/>
    </material>
    <material name="color_8">
        <color rgba="0.14 0.62 0.18 ${alpha_val}"/>
    </material>
    <material name="color_9">
        <color rgba="0.26 0.58 0.10 ${alpha_val}"/>
    </material>
    <material name="color_9b">
        <color rgba="0.40 0.52 0.07 ${alpha_val}"/>
    </material>
    <material name="color_10">
        <color rgba="0.54 0.44 0.06 ${alpha_val}"/>
    </material>
    <material name="color_11">
        <color rgba="0.66 0.34 0.07 ${alpha_val}"/>
    </material>
    <material name="color_12">
        <color rgba="0.74 0.18 0.10 ${alpha_val}"/>
    </material>

    <!-- 长方体惯性宏
        params: m质量(kg), x/y/z长宽高(m), o_xyz重心偏移, o_rpy重心姿态
    -->
    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0.0"
                     izz="${(m/12) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <!-- 实心圆柱惯性宏（杆轴线沿Z）
        params: m质量(kg), r外半径(m), l杆长(m), o_xyz重心偏移, o_rpy重心姿态
    -->
    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(m/12) * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (3*r*r + l*l)}" iyz="0.0"
                     izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <!-- 实心球体惯性宏
        params: m质量(kg), r球半径(m), o_xyz重心偏移, o_rpy重心姿态
    -->
    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
                     iyy="${2*m*r*r/5}" iyz="0.0"
                     izz="${2*m*r*r/5}"/>
        </inertial>
    </xacro:macro>

    <!-- 空心圆筒惯性宏（轴线沿Z）
        params: m总质量(kg), r_out外半径(m), r_in内孔半径(m), l杆长(m), o_xyz重心偏移, o_rpy重心姿态
    -->
    <xacro:macro name="hollow_cylinder_inertia" params="m r_out r_in l o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia
                    ixx="${(m/12) * (3*(r_out*r_out + r_in*r_in) + l*l)}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${(m/12) * (3*(r_out*r_out + r_in*r_in) + l*l)}"
                    iyz="0.0"
                    izz="${0.5 * m * (r_out*r_out + r_in*r_in)}"/>
        </inertial>
    </xacro:macro>

</robot>