<?xml version="1.0" encoding="UTF-8"?>
<!-- 全局材质库  -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="alpha_val" value="1"/>

    <!-- ================================================== -->
    <!-- S1 蓝青冷渐变 -->
